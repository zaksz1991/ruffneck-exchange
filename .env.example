# Public canonical URL
NEXT_PUBLIC_SITE_URL=https://ruffneck-exchange.vercel.app

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Private RNX operator console. Use a unique password and a random secret of at least 32 characters.
# Keep both server-only; never commit real values to GitHub.
RNX_ADMIN_PASSWORD=
RNX_ADMIN_SESSION_SECRET=

# Supplier portal session signing key (optional if RNX_ADMIN_SESSION_SECRET is present).
# Prefer a separate random value of at least 32 characters. Server-only.
RNX_SUPPLIER_SESSION_SECRET=

# Optional private payment instructions shown only to signed-in suppliers after a quote.
# Do not commit real bank/account details. Configure this in Vercel Environment Variables.
RNX_PAYMENT_INSTRUCTIONS=

# Customer portal sessions (use a new random secret, >=32 characters).
RNX_CUSTOMER_SESSION_SECRET=

# Optional transactional email via Resend. Without these, notifications stay queued.
RESEND_API_KEY=
RNX_NOTIFICATION_FROM_EMAIL=
RNX_OPERATIONS_NOTIFICATION_EMAIL=

# Protects the daily Vercel notification worker. Use a random value of at least 24 characters.
CRON_SECRET=
